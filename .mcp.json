{
  "mcpServers": {
    "prompt-library": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/shared_mcp.py",
        "connect",
        "--name",
        "prompt-library",
        "--env",
        "PYTHONUNBUFFERED",
        "--env",
        "PROMPT_LIBRARY_CSV",
        "--env",
        "PROMPT_LIBRARY_HOME",
        "--",
        "python3",
        "${CLAUDE_PLUGIN_ROOT}/server/mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
